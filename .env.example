# Database encryption key (minimum 32 characters)
DB_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Optional: InfluxDB v2 telemetry sink. When INFLUX_URL and INFLUX_TOKEN are
# set, the app writes stream-health, camera-state, and reconcile metrics to
# the configured bucket. Omit both to disable telemetry (recordMetric is a
# silent no-op). Coords for the meintechblog stack: see operator README.
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=meintechblog
INFLUX_BUCKET=default
# Optional host tag override (defaults to "ip-cam-master").
INFLUX_HOST=
